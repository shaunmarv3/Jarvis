# Which brain to use by default: ollama | deepseek
DEFAULT_BACKEND=ollama

# Local Ollama settings
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek (cloud) — only needed if you switch to the deepseek backend
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Multi-agent (orchestrator-worker): the lead agent spawns subagents up to a
# backend-dependent ceiling. Local Ollama runs them sequentially (one GPU), so the
# ceiling is a patience limit; DeepSeek runs them in parallel.
MAX_SUBAGENTS_OLLAMA=5
MAX_SUBAGENTS_DEEPSEEK=10
SUBAGENT_ROUNDS=2          # search rounds per subagent (broad query -> narrowed follow-up)
PARALLEL_SUBAGENTS=true    # run subagents concurrently (only takes effect on DeepSeek)

# How deep each subagent's reflective search loop digs (legacy single-agent knob; unused by the
# multi-agent flow but kept for the optional scripts).
MAX_LOOPS=4

# Used for the OpenAlex "polite pool" (and general contact). Optional.
CONTACT_EMAIL=shaunmarvellrodrigues@gmail.com
