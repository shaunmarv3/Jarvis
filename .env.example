# Which brain to use by default: ollama | deepseek
DEFAULT_BACKEND=ollama

# ---- Local Ollama ----
OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_LEAD_MODEL=         # optional bigger local model for the lead (planning + report)
OLLAMA_BASE_URL=http://localhost:11434

# ---- DeepSeek (cloud) ----
# Paste your key after the = (no quotes). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Strong model for the LEAD (plans, reviews gaps, writes the report — few calls),
# cheap fast model for SUBAGENTS (many tool-calling turns). Anthropic's Opus-lead/Sonnet-worker split.
DEEPSEEK_LEAD_MODEL=deepseek-v4-pro
DEEPSEEK_WORKER_MODEL=deepseek-flash
DEEPSEEK_LEAD_THINKING=true
DEEPSEEK_WORKER_THINKING=false

# ---- Multi-agent ----
MAX_SUBAGENTS_OLLAMA=4          # subagents run sequentially on one GPU (a patience limit)
MAX_SUBAGENTS_DEEPSEEK=8        # subagents run in parallel in the cloud
SUBAGENT_BUDGET_OLLAMA=6        # default tool calls per subagent (the lead may assign 3-15)
SUBAGENT_BUDGET_DEEPSEEK=10
# LEAD_ITERATION=               # one gap-filling follow-up wave; default: on for deepseek, off for ollama
MAX_FOLLOWUP_SUBAGENTS=2

# ---- Optional keys (everything works without them) ----
SEMANTIC_SCHOLAR_API_KEY=       # free; the keyless shared pool is often rate-limited (HTTP 429)
GITHUB_TOKEN=                   # raises GitHub search limits
TAVILY_API_KEY=                 # LLM-grade web search (1,000 free credits/month); else DuckDuckGo
EXA_API_KEY=                    # semantic web search

# Used for the OpenAlex "polite pool" (and general contact). Optional.
CONTACT_EMAIL=research@example.com
